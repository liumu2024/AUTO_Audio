// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 用户表
model User {
  id               Int       @id @default(autoincrement())
  userIdHash       String    @unique @map("user_id_hash")
  username         String
  concurrentLimit  Int       @default(1) @map("concurrent_limit")
  availableCredits Int       @default(100) @map("available_credits")
  createdAt        DateTime  @default(now()) @map("created_at")

  materials UserMaterial[]
  tasks     ReplicationTask[]
  v2TimelineDrafts V2TimelineDraft[]
  creativeMemories CreativeMemory[]

  @@map("users")
}

/// 用户素材表
model UserMaterial {
  id           String @id
  userId       Int    @map("user_id")
  materialType String @map("material_type")
  ossUrl       String @map("oss_url")
  label        String @default("")
  aiTags       Json?  @map("ai_tags")
  status       String @default("READY")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_materials")
}

/// 核心复刻任务表（全链路）
model ReplicationTask {
  id              String    @id
  userId          Int       @map("user_id")
  sampleVideoUrl  String    @map("sample_video_url")
  globalPrompt    String?   @map("global_prompt")
  structureJson   Json?     @map("structure_json")
  renderPlanJson  Json?     @map("render_plan_json")
  finalVideoUrl   String?   @map("final_video_url")
  taskStatus      String    @default("QUEUED") @map("task_status")
  createdAt       DateTime  @default(now()) @map("created_at")
  completedAt     DateTime? @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([taskStatus])
  @@map("replication_tasks")
}

model V2TimelineDraft {
  id            String   @id
  userId        Int      @map("user_id")
  revision      Int      @default(1)
  creationMode  String   @map("creation_mode")
  plannerInputJson Json  @map("planner_input_json")
  specJson      Json     @map("spec_json")
  plannerSource String?  @map("planner_source")
  reviewJson    Json?    @map("review_json")
  traceDir      String?  @map("trace_dir")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  revisions  V2TimelineRevision[]
  renderRuns V2TimelineRenderRun[]
  creativeMemories CreativeMemory[]

  @@index([userId])
  @@map("v2_timeline_drafts")
}

model V2TimelineRevision {
  id            String   @id
  draftId       String   @map("draft_id")
  revision      Int
  kind          String
  specJson      Json     @map("spec_json")
  plannerSource String?  @map("planner_source")
  reviewJson    Json?    @map("review_json")
  traceDir      String?  @map("trace_dir")
  createdAt     DateTime @default(now()) @map("created_at")

  draft V2TimelineDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@unique([draftId, revision])
  @@index([draftId, createdAt])
  @@map("v2_timeline_revisions")
}

model V2TimelineRenderRun {
  id                    String    @id
  draftId               String    @map("draft_id")
  sourceRevision        Int       @map("source_revision")
  sourceSpecJson        Json      @map("source_spec_json")
  resolvedSpecJson      Json?     @map("resolved_spec_json")
  status                String
  outputPath            String?   @map("output_path")
  outputUrl             String?   @map("output_url")
  traceDir              String?   @map("trace_dir")
  materialResolutionJson Json?    @map("material_resolution_json")
  evaluationJson        Json?     @map("evaluation_json")
  createdAt             DateTime  @default(now()) @map("created_at")
  completedAt           DateTime? @map("completed_at")

  draft V2TimelineDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId, createdAt])
  @@map("v2_timeline_render_runs")
}

model CreativeMemory {
  id                       String   @id
  userId                   Int      @map("user_id")
  scopeType                String   @map("scope_type")
  draftId                  String?  @map("draft_id")
  statement                String
  status                   String
  origin                   String
  sourceWorkspaceSessionId String?  @map("source_workspace_session_id")
  sourceTurnIdsJson        Json     @map("source_turn_ids_json")
  sourceExcerpt            String?  @map("source_excerpt")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")
  revokedAt                DateTime? @map("revoked_at")

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  draft V2TimelineDraft? @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([draftId, status])
  @@map("creative_memories")
}
