# PostgreSQL (Prisma)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/dpl304?schema=public"

# Redis (BullMQ task queue)
REDIS_URL="redis://127.0.0.1:6379"

# HTTP / WebSocket
PORT=3001
PUBLIC_BASE_URL=http://localhost:3001
# URL advertised for uploaded files that external model providers must fetch.
# For real Seedance image-to-video calls, point this to a public HTTPS tunnel or object-storage CDN.
# Leave unset for local-only preview; localhost uploads will be rejected before provider submission.
# PUBLIC_ASSET_BASE_URL=https://your-public-upload-host.example.com
WS_PATH=/ws/tasks

# Optional Python analyzer fallback for local development
PYTHON_BIN=python3
CLI_ANALYZER_SCRIPT=./scripts/analyzer_cli.py

# Ark video understanding
# Keep real keys in backend/.env only. Do not commit them.
ARK_API_KEY_NAME=
ARK_API_KEY=
# VIDEO_UNDERSTANDING_API_KEY=
VIDEO_UNDERSTANDING_MODEL=doubao-seed-2-0-lite-260428
VIDEO_UNDERSTANDING_FILES_URL=https://ark.cn-beijing.volces.com/api/v3/files
VIDEO_UNDERSTANDING_RESPONSES_URL=https://ark.cn-beijing.volces.com/api/v3/responses
VIDEO_UNDERSTANDING_PREPROCESS_VIDEO_FPS=0.3
VIDEO_UNDERSTANDING_TIMEOUT_MS=300000
VIDEO_UNDERSTANDING_FILE_READY_TIMEOUT_MS=180000
VIDEO_UNDERSTANDING_FILE_READY_POLL_INTERVAL_MS=2000

# Unified runtime trace
ENABLE_AGENT_TRACE=true
AGENT_TRACE_DIR=tmp/agent-trace
# Optional per-module overrides. Leave unset to keep all artifacts under AGENT_TRACE_DIR.
# VIDEO_UNDERSTANDING_DEBUG_ARTIFACT_DIR=tmp/agent-trace
# EFFECT_DEBUG_ARTIFACT_DIR=tmp/agent-trace
# REMOTION_COMPONENT_AUTHORING_DEBUG_DIR=tmp/agent-trace

# Remotion rendering
REMOTION_ROOT=../remotion
REMOTION_COMPOSITION_ID=Dpl304Video
RENDER_OUTPUT_DIR=renders
# Prefer a full FFmpeg build for V2 generated-material standardization and overlay composition.
# FFMPEG_BIN=C:\Users\Administrator\AppData\Local\Microsoft\WinGet\Links\ffmpeg.exe
# REMOTION_BROWSER_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe

# Optional Remotion component authoring
ENABLE_REMOTION_COMPONENT_AUTHORING=false
ENABLE_REMOTION_COMPONENT_SAMPLE_RENDER=false

# Effect roadmap and debug artifacts
ENABLE_EFFECT_DEBUG_ARTIFACTS=true
ENABLE_ROADMAP_COMPILED_EFFECT_LAYERS=true
ENABLE_SEED_PLUGIN_AUTHORING=false

# V2 video generation
# Provider-specific submit/status/download endpoints are wired by the concrete adapter.
V2_VIDEO_GENERATION_PROVIDER=ark-seedance
V2_VIDEO_GENERATION_API_KEY=
V2_VIDEO_GENERATION_MODEL=doubao-seedance-1-5-pro-251215
V2_VIDEO_GENERATION_SUBMIT_URL=https://ark.cn-beijing.volces.com/api/v3/contents/generations/tasks
V2_VIDEO_GENERATION_STATUS_URL_TEMPLATE=https://ark.cn-beijing.volces.com/api/v3/contents/generations/tasks/{id}
# V2_VIDEO_GENERATION_DOWNLOAD_URL_TEMPLATE=
# V2_VIDEO_GENERATION_DEFAULT_IMAGE_URL=
V2_VIDEO_GENERATION_TIMEOUT_MS=180000
V2_VIDEO_GENERATION_POLL_INTERVAL_MS=3000
V2_GENERATED_VIDEO_WIDTH=1080
V2_GENERATED_VIDEO_HEIGHT=1920
V2_GENERATED_VIDEO_FPS=30
