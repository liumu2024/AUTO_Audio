{
  "name": "bytedance-dpl304-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "start": "node dist/app.js",
    "build": "npm run build:shared && tsc",
    "build:shared": "tsc -p ../shared/tsconfig.json",
    "test:smoke:v2": "npm run test:smoke:v2:remotion-timeline-service",
    "test:smoke:v2:boundaries": "tsx scripts/check-v2-import-boundaries.ts",
    "test:smoke:v2:ffmpeg-preflight": "tsx scripts/smoke-v2-ffmpeg-preflight.ts",
    "test:smoke:v2:asset-publisher": "tsx scripts/smoke-v2-asset-publisher.ts",
    "test:smoke:v2:material-analysis": "npm run build:shared && tsx scripts/smoke-v2-material-analysis.ts",
    "test:smoke:v2:remotion-timeline-spec": "npm run build:shared && tsx scripts/smoke-v2-remotion-timeline-spec.ts",
    "test:smoke:v2:remotion-timeline-planner": "npm run build:shared && tsx scripts/smoke-v2-remotion-timeline-planner.ts",
    "verify:v2:image-model-access": "tsx scripts/verify-v2-image-model-access.ts",
    "test:smoke:v2:remotion-timeline-material": "npm run build:shared && tsx scripts/smoke-v2-remotion-timeline-material-resolver.ts",
    "test:smoke:v2:creation-modes": "npm run build:shared && tsx scripts/smoke-v2-remotion-timeline-creation-modes.ts",
    "test:smoke:v2:text-to-video-run": "npm run build:shared && tsx scripts/smoke-v2-remotion-timeline-text-to-video-run.ts",
    "test:smoke:v2:remotion-timeline-render": "npm run build:shared && tsx scripts/smoke-v2-remotion-timeline-render.ts",
    "test:smoke:v2:remotion-timeline-service": "npm run build:shared && tsx scripts/smoke-v2-remotion-timeline-service.ts",
    "test:smoke:v2:material-adapter": "tsx scripts/smoke-v2-material-adapter.ts",
    "test:smoke:v2:ark-seedance-adapter": "tsx scripts/smoke-v2-ark-seedance-adapter.ts",
    "test:smoke:v2:director-context-isolation": "npm run build:shared && tsx scripts/smoke-v2-director-context-isolation.ts",
    "test:smoke:v2:sample-ui": "tsx --tsconfig ../fonted/tsconfig.app.json ../fonted/scripts/smoke-v2-sample-ui.ts",
    "test:smoke:v2:editor-route-isolation": "tsx scripts/smoke-v2-editor-route-isolation.ts",
    "test:smoke:v2:http-route-boundary": "tsx scripts/smoke-v2-http-route-boundary.ts",
    "test:smoke:v2:remotion-root-composition": "tsx scripts/smoke-v2-remotion-root-composition.ts",
    "test:smoke:v2:director-routing": "npm run build:shared && tsx scripts/smoke-v2-director-routing.ts",
    "test:smoke:v2:timeline-draft-history": "npm run build:shared && tsx scripts/smoke-v2-timeline-draft-history.ts",
    "test:smoke:v2:timeline-draft-history-ui": "npm run build:shared && tsx scripts/smoke-v2-timeline-draft-history-ui.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "@types/multer": "^2.1.0",
    "@volcengine/tos-sdk": "^2.9.1",
    "bytedance-dpl304-desktop": "file:..",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "multer": "^2.1.1",
    "pyyaml": "^0.0.1",
    "ws": "^8.18.2",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.21",
    "@types/ws": "^8.18.1",
    "prisma": "^6.8.2",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3"
  }
}
