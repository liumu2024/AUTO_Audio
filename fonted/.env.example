# 复制为 .env.development 开启本机联调
# cp .env.example .env.development

# true = 连接本机 backend（推荐联调）
VITE_USE_BACKEND=true

# 本机 backend（Express 默认 3001）
VITE_API_BASE=http://localhost:3001
VITE_WS_BASE=ws://localhost:3001
VITE_WS_PATH=/ws/tasks

# 与 backend 鉴权占位一致
VITE_USER_ID=1

# 提交分析任务用的样例视频 URL
VITE_SAMPLE_VIDEO_URL=https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4
